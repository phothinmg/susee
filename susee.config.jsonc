{
	"entryPoints": [
		// main entry point
		{
			"entry": "__local__/ts/index.ts",
			"exportPath": ".",
			"format": ["esm", "commonjs"],
			"tsconfigFilePath": null,
			"warning": false
		},
			{
			"entry": "__local__/cjs/index.cjs",
			"exportPath": "./cjs",
			"format": ["esm", "commonjs"],
			"tsconfigFilePath": null,
			"warning": false
		}
	],
	"outDir": "out",
	"allowUpdatePackageJson": false
}
