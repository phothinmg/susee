{
	"name": "susee",
	"version": "1.5.6",
	"description": "TypeScript-first bundler for library packages",
	"type": "module",
	"main": "dist/index.cjs",
	"types": "dist/index.d.cts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"bin": {
		"susee": "bin/susee"
	},
	"scripts": {
		"build": "tsx build.ts",
		"lint": "biome check src  --write",
		"fmt": "biome format --write",
		"test": "tsx --test",
		"coverage": "npx tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=__tests__/coverage/lcov.info",
		"hooks:install": "bash scripts/install-hooks.sh",
		"lint:test": "biome check tests --write",
		"commit": "bash scripts/commit.sh",
		"v:patch": "npm version patch --no-git-tag-version",
		"v:minor": "npm version minor --no-git-tag-version",
		"v:major": "npm version major --no-git-tag-version",
		"vercel:install": "npm i mmcov shiki && bundle install",
		"jekyll:build": "JEKYLL_ENV=production bundle exec jekyll build",
		"mmcov:build": "bash scripts/mmcov.sh",
		"pre:cache": "mkdir -p docs/.jekyll-cache && cp -r node_modules/.jekyll-cache-backup/. docs/.jekyll-cache/ 2>/dev/null || true ",
		"vercel:build": "npm run pre:cache && npm run jekyll:build && npm run mmcov:build",
		"postbuild": "mkdir -p node_modules/.jekyll-cache-backup && cp -r docs/.jekyll-cache/. node_modules/.jekyll-cache-backup/",
		"docs:dev": "bundle exec jekyll serve --profile",
		"docs:init": "bash scripts/setup.sh"
	},
	"keywords": [
		"bundler",
		"susee",
		"suseejs"
	],
	"author": {
		"name": "Pho Thin Mg",
		"email": "phothinmg@disroot.org",
		"url": "https://phothinmg.github.io/"
	},
	"license": "Apache-2.0",
	"files": [
		"package.json",
		"README.md",
		"LICENSE",
		"dist/**/*",
		"bin/**/*"
	],
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"repository": {
		"url": "git+https://github.com/phothinmg/susee.git",
		"type": "git"
	},
	"homepage": "https://susee.js.org/",
	"bugs": {
		"url": "https://github.com/phothinmg/susee/issues"
	},
	"dependencies": {
		"@suseejs/terser-plugin": "^0.0.7",
		"@typescript/typescript6": "^6.0.2",
		"mmcov": "^0.0.8",
		"shiki": "^4.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@suseejs/banner-text-plugin": "^0.0.7",
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
