{
  "name": "susee",
  "version": "2.0.1",
  "description": "TypeScript-first bundler for library packages",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "susee": "bin/susee"
  },
  "scripts": {
    "build": "npx napi build --platform --config-path napi.config.json --output-dir ./dist",
    "hooks:install": "bash scripts/install-hooks.sh",
    "commit": "bash scripts/commit.sh"
  },
  "keywords": [
    "bundler",
    "susee",
    "suseejs"
  ],
  "author": "Pho Thin Mg <phothinmg@disroot.org> (https://phothinmg.github.io/)",
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "index.d.ts",
    "bin/**/*"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "url": "git+https://github.com/phothinmg/susee.git",
    "type": "git"
  },
  "homepage": "https://susee.js.org/",
  "bugs": {
    "url": "https://github.com/phothinmg/susee/issues"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  },
  "workspaces": [
    "susee-docs"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
